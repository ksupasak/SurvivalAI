# Port and bind address
PORT=3000
HOST=0.0.0.0

# Set to 1 (or the hop count) when running behind a reverse proxy such as
# Fly.io, Render, nginx or Cloudflare. Rate limiting is per-IP and needs the
# real client address from X-Forwarded-For.
TRUST_PROXY=

# Comma-separated origins allowed to call the API from a browser.
# Leave empty to allow all (the native app sends no Origin header).
# ALLOWED_ORIGINS=https://survivalai.app,https://www.survivalai.app

# Shared key callers must send as `X-API-Key` (or `Authorization: Bearer <key>`).
# Leave empty to keep the API open. /api/health is always reachable.
# Generate with: openssl rand -hex 32
API_KEY=

# Set to true to keep GET requests open while still requiring the key for
# anything that writes.
API_KEY_ALLOW_PUBLIC_READ=

# Secret that permits deleting any message, for moderating abuse.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional Expo access token for push (required only if your Expo project
# has "Enhanced Security for Push Notifications" enabled).
EXPO_ACCESS_TOKEN=

# Distinct devices that must report a message before it is auto-hidden
# pending review.
AUTO_HIDE_REPORTS=3

# Rate limits (defaults shown)
POST_RATE_WINDOW_MS=600000
POST_RATE_MAX=10
DELETE_RATE_WINDOW_MS=600000
DELETE_RATE_MAX=30
SUBSCRIBE_RATE_WINDOW_MS=3600000
SUBSCRIBE_RATE_MAX=20
REPORT_RATE_WINDOW_MS=600000
REPORT_RATE_MAX=20
READ_RATE_WINDOW_MS=60000
READ_RATE_MAX=300
