{
  "expo": {
    "name": "SurvivalAI",
    "slug": "survival-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "survivalai",
    "primaryColor": "#d97706",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.survivalai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Camera is used to read Morse code light signals from other survivors.",
        "NSMicrophoneUsageDescription": "Microphone is used for voice input in the AI chat.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition converts your spoken questions into text for the AI chat.",
        "NSLocationWhenInUseUsageDescription": "Location is used to share your coordinates in Seeking mode so rescuers and nearby survivors can find you.",
        "NSLocalNetworkUsageDescription": "The local network is used to broadcast and discover survival beacons and to host peer-to-peer chat when no internet is available.",
        "NSBonjourServices": [
          "_survivalai._udp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0E17"
      },
      "package": "com.survivalai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-location",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#d97706",
          "sounds": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Microphone is used for voice input in the AI chat.",
          "speechRecognitionPermission": "Speech recognition converts your spoken questions into text for the AI chat.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withLocalNetworkSecurity"
    ],
    "extra": {
      "boardServerUrl": "",
      "eas": {
        "projectId": ""
      },
      "boardApiKey": ""
    }
  }
}
